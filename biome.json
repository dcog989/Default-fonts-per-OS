{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noImportantStyles": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "none"
		}
	},
	"files": {
		"includes": [
			"**/*.{js,mjs,cjs,json,jsonc,html,htm,css}",
			"!data",
			"!repomix.config.json",
			"!bun.lock",
			"!.github",
			"!node_modules"
		]
	}
}
